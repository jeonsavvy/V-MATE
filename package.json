{
  "name": "v-mate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "node server/cloud-run-server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "node server/run-tests.js",
    "test:server:coverage": "node scripts/run-server-coverage.mjs",
    "test:contracts:coverage": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include=server/platform/asset-contracts.js --test-coverage-include=server/platform/quota-contract.js server/platform/asset-contracts.test.js server/platform/input-contracts.test.js server/platform/quota-contract.test.js",
    "test:ui": "vitest run",
    "test:db:fresh": "node scripts/run-db-tests.mjs --fresh",
    "test:db:upgrade": "node scripts/run-db-tests.mjs --upgrade",
    "test:db": "node scripts/run-db-tests.mjs --all",
    "validate:surfaces": "node scripts/validate-github-workflows.mjs && node scripts/validate-public-surface.mjs",
    "verify": "npm run validate:surfaces && npm run typecheck && npm test && npm run test:contracts:coverage && npm run build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "release:manifest": "node scripts/create-dist-manifest.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "smoke:staging": "node scripts/staging-synthetic-smoke.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:dry-run": "npm run build && wrangler versions upload --dry-run --env=",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@supabase/supabase-js": "^2.39.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.303.0",
    "motion": "^12.35.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^1.4.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "jsdom": "^29.1.1",
    "postcss": "8.5.23",
    "supabase": "2.109.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.7",
    "wrangler": "4.122.0",
    "yaml": "2.9.0"
  }
}
